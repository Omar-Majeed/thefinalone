NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Resend (email delivery) ───────────────────────────────────────────────
# Create an API key at https://resend.com/api-keys
RESEND_API_KEY=

# Where internal lead notifications are sent.
CONTACT_EMAIL=info@axenity.com

# Verified sender address (must be on a domain verified in Resend).
FROM_EMAIL=info@axenity.com

# ── Cloudflare Turnstile (bot protection) ─────────────────────────────────
# https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Upstash Redis (rate limiting) ─────────────────────────────────────────
# https://console.upstash.com/redis
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
